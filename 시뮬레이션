<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>바이러스 치사율과 전파속도 시뮬레이션</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: 'Malgun Gothic', sans-serif; background-color: #f4f7f6; color: #333; margin: 0; padding: 20px; }
        .container { max-width: 900px; margin: auto; background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        h1 { text-align: center; color: #2c3e50; font-size: 24px; }
        .dashboard { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 20px; background: #ecf0f1; padding: 15px; border-radius: 8px; }
        .control-group { flex: 1 1 45%; display: flex; flex-direction: column; }
        label { font-weight: bold; margin-bottom: 5px; font-size: 14px; }
        input[type="range"], input[type="number"] { width: 100%; margin-bottom: 10px; }
        .summary { text-align: center; margin-top: 20px; padding: 15px; background: #e74c3c; color: white; border-radius: 8px; font-size: 18px; font-weight: bold; }
        canvas { max-width: 100%; margin-top: 20px; }
    </style>
</head>
<body>

<div class="container">
    <h1>🔬 바이러스 치사율에 따른 전파 시뮬레이션 (SIRD 모델)</h1>
    
    <div class="dashboard">
        <div class="control-group">
            <label>전체 인구수 (명): <span id="val-pop">10000</span></label>
            <input type="number" id="total-pop" value="10000" min="1000" max="100000" step="1000">
            
            <label>초기 감염자 수 (명): <span id="val-init-inf">10</span></label>
            <input type="number" id="init-inf" value="10" min="1" max="100">
            
            <label>기초 감염 재생산지수 (R0): <span id="val-r0">3.0</span></label>
            <input type="range" id="r0" value="3.0" min="0.1" max="10.0" step="0.1">
        </div>
        
        <div class="control-group">
            <label>감염 유지 기간 (일): <span id="val-recovery">7</span></label>
            <input type="range" id="recovery" value="7" min="1" max="30" step="1">
            
            <label>방역 정책 수준 (% - 거리두기 등): <span id="val-quarantine">0</span>%</label>
            <input type="range" id="quarantine" value="0" min="0" max="100" step="1">
            
            <label style="color:#c0392b; font-size:16px;">🩸 바이러스 치사율 (%): <span id="val-fatality">5</span>%</label>
            <input type="range" id="fatality" value="5" min="0" max="100" step="1">
        </div>
    </div>

    <div class="summary">
        100일 후 결과 ➔ 누적 감염자: <span id="total-infected">0</span>명 | 총 사망자: <span id="total-dead">0</span>명
    </div>

    <canvas id="simulationChart"></canvas>
</div>

<script>
    let simChart;

    function runSimulation() {
        // 1. 사용자 입력값 가져오기
        const N = parseInt(document.getElementById('total-pop').value);
        const I0 = parseInt(document.getElementById('init-inf').value);
        const R0 = parseFloat(document.getElementById('r0').value);
        const recoveryDays = parseFloat(document.getElementById('recovery').value);
        const quarantineRate = parseFloat(document.getElementById('quarantine').value) / 100;
        const fatalityRate = parseFloat(document.getElementById('fatality').value) / 100;

        // 텍스트 업데이트
        document.getElementById('val-pop').innerText = N;
        document.getElementById('val-init-inf').innerText = I0;
        document.getElementById('val-r0').innerText = R0.toFixed(1);
        document.getElementById('val-recovery').innerText = recoveryDays;
        document.getElementById('val-quarantine').innerText = (quarantineRate * 100).toFixed(0);
        document.getElementById('val-fatality').innerText = (fatalityRate * 100).toFixed(0);

        // 2. 모델링 파라미터 계산 (수학 공식 적용)
        const beta = (R0 / recoveryDays) * (1 - quarantineRate); // 전파율
        const gamma = (1 - fatalityRate) / recoveryDays;       // 회복률
        const mu = fatalityRate / recoveryDays;                // 사망률

        // 3. 배열 초기화
        let S = N - I0; // 미감염자 (Susceptible)
        let I = I0;     // 현재 감염자 (Infected)
        let R = 0;      // 회복자 (Recovered)
        let D = 0;      // 사망자 (Dead)
        let cumulativeI = I0; // 누적 감염자

        const days = 100;
        const historyS = [S], historyI = [I], historyR = [R], historyD = [D];
        const labels = [0];

        // 4. 시뮬레이션 계산 (오일러 방법 적용)
        for (let t = 1; t <= days; t++) {
            const newInfections = (beta * S * I) / N;
            const newRecoveries = gamma * I;
            const newDeaths = mu * I;

            S = Math.max(0, S - newInfections);
            I = Math.max(0, I + newInfections - newRecoveries - newDeaths);
            R = R + newRecoveries;
            D = D + newDeaths;
            cumulativeI = cumulativeI + newInfections;

            historyS.push(Math.round(S));
            historyI.push(Math.round(I));
            historyR.push(Math.round(R));
            historyD.push(Math.round(D));
            labels.push(t);
        }

        // 5. 결과 요약 업데이트
        document.getElementById('total-infected').innerText = Math.round(cumulativeI).toLocaleString();
        document.getElementById('total-dead').innerText = Math.round(D).toLocaleString();

        // 6. 그래프 그리기
        const ctx = document.getElementById('simulationChart').getContext('2d');
        if (simChart) simChart.destroy(); // 기존 그래프 지우기

        simChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    { label: '미감염자 (S)', data: historyS, borderColor: '#3498db', fill: false, pointRadius: 0 },
                    { label: '현재 감염자 (I)', data: historyI, borderColor: '#e67e22', fill: true, backgroundColor: 'rgba(230, 126, 34, 0.2)', pointRadius: 0 },
                    { label: '회복자 (R)', data: historyR, borderColor: '#2ecc71', fill: false, pointRadius: 0 },
                    { label: '누적 사망자 (D)', data: historyD, borderColor: '#c0392b', fill: true, backgroundColor: 'rgba(192, 57, 43, 0.2)', pointRadius: 0 }
                ]
            },
            options: {
                responsive: true,
                animation: false,
                scales: {
                    x: { title: { display: true, text: '시간 (일)' } },
                    y: { title: { display: true, text: '인구 수 (명)' }, min: 0 }
                },
                plugins: {
                    title: { display: true, text: '시간에 따른 전염병 확산 추이' }
                }
            }
        });
    }

    // 입력값이 변경될 때마다 시뮬레이션 다시 실행
    document.querySelectorAll('input').forEach(input => {
        input.addEventListener('input', runSimulation);
    });

    // 초기 화면 실행
    runSimulation();
</script>

</body>
</html>
